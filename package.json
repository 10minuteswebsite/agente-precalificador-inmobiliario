{
  "name": "agente-precalificador-inmobiliario",
  "type": "module",
  "version": "1.0.0",
  "description": "Módulo versionado de precalificación inmobiliaria para agentes conversacionales",
  "repository": {
    "type": "git",
    "url": "https://github.com/10minuteswebsite/agente-precalificador-inmobiliario.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "module-manifest.json",
    "docs/contracts/",
    "README.md",
    "AGENTS.md",
    "moving.md",
    "HANDOFF.md"
  ],
  "exports": {
    ".": "./src/prequalifier/index.js",
    "./manifest": "./module-manifest.json"
  },
  "scripts": {
    "build": "node -e \"console.log('No build step required')\"",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "audit:isolation": "node scripts/audit-supabase-isolation.mjs",
    "vercel-build": "npm run build",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:prequalifier": "node scripts/verify-prequalifier.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  }
}
